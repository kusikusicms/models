{
  "name": "kusikusicms/models",
  "description": "Core Eloquent models for KusikusiCMS.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "illuminate/support": "^13.0",
    "illuminate/database": "^13.0",
    "pugx/shortid-php": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "KusikusiCMS\\Models\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KusikusiCMS\\Models\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "KusikusiCMS\\Models\\ModelsServiceProvider"
      ]
    },
    "branch-alias": {
      "dev-main": "13.x-dev"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^13.0"
  },
  "config": {
    "sort-packages": true
  }
}
